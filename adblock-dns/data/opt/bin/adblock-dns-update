#!/bin/sh
# adblock-dns-update [genconf|logrotate|stats]
#   genconf    - only regenerate dnsmasq config from adblock-dns.conf
#   logrotate  - rotate LOG_FILE if it grew past LOG_MAX_KB
#   stats      - make dnsmasq dump cache statistics into the log
#   (no args)  - regenerate config, download blocklists, reload dnsmasq

CONF="/opt/etc/adblock-dns/adblock-dns.conf"
WORK_DIR="/opt/var/adblock-dns"
DNSMASQ_CONF="$WORK_DIR/dnsmasq.conf"
BLACKLIST_CONF="$WORK_DIR/blacklist.conf"
BLOCK_HOSTS="$WORK_DIR/blocked.hosts"
PID_FILE="$WORK_DIR/dnsmasq.pid"
INIT_SCRIPT="/opt/etc/init.d/S56adblock-dns"

log() {
    echo "adblock-dns: $1"
}

fail() {
    log "ERROR: $1" >&2
    exit 1
}

# Sends a signal to the running dnsmasq. Returns 1 when it is not running.
signal_dnsmasq() {
    [ -f "$PID_FILE" ] || return 1
    pid="$(cat "$PID_FILE")"
    kill -0 "$pid" 2>/dev/null || return 1
    kill -"$1" "$pid"
}

# dnsmasq keeps the log file open, so after moving it away we send SIGUSR2 to
# make the running process reopen the configured path.
rotate_log() {
    [ -n "$LOG_FILE" ] && [ -f "$LOG_FILE" ] || return 0
    max_kb="${LOG_MAX_KB:-512}"
    [ "$max_kb" -gt 0 ] || return 0
    size_kb=$(($(wc -c < "$LOG_FILE") / 1024))
    [ "$size_kb" -ge "$max_kb" ] || return 0

    keep="${LOG_KEEP:-1}"
    if [ "$keep" -le 0 ]; then
        : > "$LOG_FILE"
        signal_dnsmasq USR2
        log "log truncated at ${size_kb}KB"
        return 0
    fi

    rm -f "$LOG_FILE.$keep"
    i="$keep"
    while [ "$i" -gt 1 ]; do
        prev=$((i - 1))
        [ -f "$LOG_FILE.$prev" ] && mv "$LOG_FILE.$prev" "$LOG_FILE.$i"
        i="$prev"
    done
    mv "$LOG_FILE" "$LOG_FILE.1"
    : > "$LOG_FILE"
    signal_dnsmasq USR2
    log "log rotated at ${size_kb}KB, previous kept as $LOG_FILE.1"
    return 0
}

[ -f "$CONF" ] || fail "config $CONF not found"
. "$CONF"

# Strips CR/comments/whitespace, lowercases and keeps only valid domain lines.
normalize_list() {
    [ -f "$1" ] || return 0
    sed -e 's/\r//' -e 's/#.*//' -e 's/[[:space:]]//g' "$1" | \
        tr 'A-Z' 'a-z' | grep -E '^[a-z0-9._-]+\.[a-z0-9-]+$' | sort -u
}

# Builds blacklist.conf from BLACKLIST_FILE minus WHITELIST_FILE.
# Whitelist entries also get server=/domain/upstream lines: the most
# specific match wins in dnsmasq, so they punch holes in blocked zones.
gen_blacklist_conf() {
    bl="$WORK_DIR/bl.$$"
    wl="$WORK_DIR/wl.$$"
    normalize_list "$BLACKLIST_FILE" > "$bl"
    normalize_list "$WHITELIST_FILE" > "$wl"
    first_upstream="$(echo $UPSTREAM_DNS | cut -d' ' -f1)"
    {
        echo "# Generated from $BLACKLIST_FILE / $WHITELIST_FILE. Do not edit."
        if [ -s "$wl" ]; then
            grep -vxF -f "$wl" "$bl" | sed 's|.*|address=/&/0.0.0.0|'
            sed "s|.*|server=/&/$first_upstream|" "$wl"
        else
            sed 's|.*|address=/&/0.0.0.0|' "$bl"
        fi
    } > "$BLACKLIST_CONF"
    rm -f "$bl" "$wl"
}

gen_dnsmasq_conf() {
    mkdir -p "$WORK_DIR"
    [ -n "$LOG_FILE" ] && mkdir -p "$(dirname "$LOG_FILE")"
    [ -f "$BLOCK_HOSTS" ] || : > "$BLOCK_HOSTS"
    gen_blacklist_conf
    {
        echo "# Generated by adblock-dns-update from $CONF. Do not edit."
        echo "port=${LISTEN_PORT:-53}"
        [ -n "$LISTEN_ADDR" ] && {
            echo "listen-address=$LISTEN_ADDR"
            echo "bind-interfaces"
        }
        echo "no-resolv"
        echo "domain-needed"
        echo "bogus-priv"
        echo "cache-size=${CACHE_SIZE:-1500}"
        echo "pid-file=$PID_FILE"
        for srv in $UPSTREAM_DNS; do
            echo "server=$srv"
        done
        if [ "$BLOCKING_ENABLED" = "yes" ]; then
            echo "addn-hosts=$BLOCK_HOSTS"
            echo "conf-file=$BLACKLIST_CONF"
        fi
        if [ -n "$LOG_FILE" ]; then
            echo "log-facility=$LOG_FILE"
            # Queue log writes so query logging never stalls the resolver
            # while the USB flash is busy.
            echo "log-async=25"
        fi
        [ "$LOG_QUERIES" = "yes" ] && echo "log-queries"
    } > "$DNSMASQ_CONF"
}

download_blocklists() {
    [ "$BLOCKING_ENABLED" = "yes" ] || {
        log "blocking disabled, skipping blocklist download"
        : > "$BLOCK_HOSTS"
        return 0
    }
    raw="$WORK_DIR/raw.$$"
    domains="$WORK_DIR/domains.$$"
    trap 'rm -f "$raw" "$domains"' EXIT
    : > "$raw"

    fetched=0
    for url in $BLOCKLIST_URLS; do
        log "downloading $url"
        if wget -q -O - "$url" >> "$raw"; then
            fetched=$((fetched + 1))
        else
            log "WARNING: failed to download $url" >&2
        fi
    done
    [ "$fetched" -gt 0 ] || fail "no blocklist downloaded, keeping previous $BLOCK_HOSTS"

    # Accept "0.0.0.0 domain" / "127.0.0.1 domain" hosts lines and bare domains.
    sed 's/\r//' "$raw" | awk '
        {
            sub(/#.*/, "")
            if (NF == 0) next
            d = ""
            if (NF >= 2 && ($1 == "0.0.0.0" || $1 == "127.0.0.1")) d = $2
            else if (NF == 1) d = $1
            d = tolower(d)
            if (d ~ /^[a-z0-9._-]+\.[a-z0-9-]+$/ && d != "localhost.localdomain") print d
        }' | sort -u > "$domains"

    wl="$WORK_DIR/dwl.$$"
    normalize_list "$WHITELIST_FILE" > "$wl"
    if [ -s "$wl" ]; then
        grep -vxF -f "$wl" "$domains" > "$domains.f" && mv "$domains.f" "$domains"
    fi
    rm -f "$wl"

    awk '{print "0.0.0.0", $1}' "$domains" > "$BLOCK_HOSTS.new" && \
        mv "$BLOCK_HOSTS.new" "$BLOCK_HOSTS"
    log "blocklist updated: $(wc -l < "$BLOCK_HOSTS") domains blocked"
}

reload_dnsmasq() {
    if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
        # SIGHUP re-reads addn-hosts; full restart is needed for config changes
        "$INIT_SCRIPT" restart
    else
        log "dnsmasq is not running; start it with: $INIT_SCRIPT start"
    fi
}

case "$1" in
    genconf)
        rotate_log
        gen_dnsmasq_conf
        ;;
    logrotate)
        rotate_log
        ;;
    stats)
        signal_dnsmasq USR1 || fail "dnsmasq is not running"
        log "cache statistics written to ${LOG_FILE:-syslog}"
        ;;
    "")
        rotate_log
        gen_dnsmasq_conf
        download_blocklists
        reload_dnsmasq
        ;;
    *)
        echo "Usage: adblock-dns-update [genconf|logrotate|stats]" >&2
        exit 1
        ;;
esac
